#!/usr/bin/env python
"""Run the locally retained ODA converter with an isolated, short-lived X server."""
import os,selectors,subprocess,sys,tempfile
from pathlib import Path

oda=Path('/workspace/cad-tools/oda/usr/bin/ODAFileConverter_27.9.0.0/ODAFileConverter')
xvfb=Path('/workspace/cad-tools/xvfb/usr/bin/Xvfb')
if len(sys.argv)<7:
 raise SystemExit('Usage: tools/oda-convert INPUT_DIR OUTPUT_DIR ACAD2013 DWG|DXF RECURSE AUDIT [FILTER]')
if not oda.is_file() or not xvfb.is_file():
 raise SystemExit('Retained ODA/Xvfb missing; see the official ODA download and setup evidence. No unverified fallback is used.')
with tempfile.TemporaryDirectory(prefix='oda-session-',dir='/tmp') as tmp:
 with open(Path(tmp)/'xvfb.log','wb') as log:
  server=subprocess.Popen([str(xvfb),'-displayfd','1','-screen','0','1280x1024x24','-ac','-nolisten','tcp','-fp','built-ins'],
                           stdout=subprocess.PIPE,stderr=log)
  try:
   sel=selectors.DefaultSelector();sel.register(server.stdout,selectors.EVENT_READ)
   if not sel.select(10):raise RuntimeError('Private X server did not become ready')
   display=server.stdout.readline().decode().strip()
   if not display.isdigit():raise RuntimeError('Private X server failed')
   env=os.environ.copy();env.update(DISPLAY=':'+display,QT_QPA_PLATFORM='xcb',XDG_CACHE_HOME='/workspace/.cache')
   code=subprocess.run([str(oda),*sys.argv[1:]],env=env,timeout=120).returncode
  finally:
   server.terminate()
   try:server.wait(timeout=5)
   except subprocess.TimeoutExpired:server.kill();server.wait()
raise SystemExit(code)
